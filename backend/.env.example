# Copy to your host's variable settings (Railway). NEVER commit real values.
DATABASE_URL=postgres://user:password@host:5432/db
PORT=8080
ALLOWED_ORIGIN=https://your-frontend.example
OWNER_PASSCODE=change-me
ELEVENLABS_API_KEY=placeholder

# Monetization (all optional; checkout stays a stub until ALL are set)
OWNER_PLAN=free                 # free | creator | studio (sets monthly speak quota)
CHECKOUT_ENABLED=false          # set "true" only after you approve going live
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PRICE_CREATOR=price_placeholder
STRIPE_PRICE_STUDIO=price_placeholder

# License keys from paid Stripe checkout (webhook: POST /api/stripe/webhook). Placeholders only.
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# STRIPE_PRICE_CREATOR / STRIPE_PRICE_STUDIO (above) double as the server-side price -> tier map.
# Recommended: reuse the app's own Postgres. Unset (and no LICENSE_DB) => webhook returns 503 and keys are denied.
LICENSE_DATABASE_URL=postgres://user:password@host:5432/db   # same value as DATABASE_URL
# LICENSE_DATABASE_SSL=require   # only if your host needs TLS
# LICENSE_DB=/data/licenses.sqlite   # alternative: SQLite on a persistent volume
